# .env.example

OPENROUTER_API_KEY=sk-or-v1-...
# Optional direct provider keys when provider is set to openai, anthropic, or google
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...
# Host-only token for discovery and configured disclosure actions
GITHUB_TOKEN=github_pat_...
# Required for sandbox mode; use a distinct, read-only fine-grained token
FIACH_REVIEW_GITHUB_TOKEN=github_pat_read_only_...
RUST_LOG=info
